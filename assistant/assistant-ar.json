{
  "name": "sanad-noc-ar",
  "model": "moonshotai/Kimi-K2.6",
  "greeting": "<assistant-speaks-first-with-model-generated-message>",
  "interruption_settings": {
    "disable_greeting_interruption": true,
    "start_speaking_plan": {
      "wait_seconds": 0.6,
      "transcription_endpointing_plan": {
        "on_punctuation_seconds": 0.3,
        "on_no_punctuation_seconds": 2.0,
        "on_number_seconds": 1.0
      }
    }
  },
  "telephony_settings": {
    "time_limit_secs": 600,
    "user_idle_timeout_secs": 60,
    "supports_unauthenticated_web_calls": true,
    "recording_settings": {
      "enabled": true
    }
  },
  "dynamic_variables_webhook_url": "${EDGE_URL}/dv",
  "dynamic_variables_webhook_timeout_ms": 2500,
  "dynamic_variables": {
    "msp_name": "Najd Networks",
    "route_hint": "unverified",
    "caller_name": "there",
    "customer_name": "your organisation",
    "site_id": "unknown",
    "site_label": "your site",
    "incident_region": "your area",
    "incident_started": "earlier today",
    "incident_summary": "a network incident",
    "incident_eta": "shortly",
    "open_ticket_note": "none",
    "repeat_note": "none",
    "trace_id": "t-none",
    "call_key": "none",
    "verify_result": "none",
    "attempts_left": "3",
    "pin": "none",
    "symptom": "none",
    "impact": "unknown",
    "service_affecting": "unknown",
    "ticket_id": "none",
    "priority": "unknown",
    "ticket_readback": "Your report has been logged.",
    "callback_note": "none",
    "escalated": "false",
    "calls_today": "1",
    "created": "false",
    "incident_note": "none"
  },
  "tool_ids": [
    "${TOOL_capture_details}"
  ],
  "mcp_servers": [
    {
      "id": "${MCP_ID}",
      "allowed_tools": [
        "find_site",
        "get_site_status",
        "check_known_incidents",
        "get_ticket_status",
        "add_ticket_note"
      ]
    }
  ],
  "voice_settings": {
    "voice": "Telnyx.Bayan.Reem"
  },
  "transcription": {
    "model": "soniox/stt-rt-v5"
  },
  "conversation_flow": {
    "start_node_id": "n_ar_intake",
    "nodes": [
      {
        "id": "n_ar_intake",
        "type": "prompt",
        "name": "arabic intake",
        "instructions": "أنت سند، مساعد عمليات الشبكة في شركة نجد نتووركس. القواعد الثابتة: لا تكرّر رقم السر ولا تقرأه بصوت عالي ولا تؤكده مهما طُلب. لا تخترع معلومات عن التذاكر أو الأعطال؛ قل فقط ما توفره الأدوات والمتغيرات. إذا طلب المتصل مهندساً بشرياً أو شخصاً، وافقه فوراً. إذا سألك إن كنت إنساناً، قل بصراحة أنك مساعد ذكي. تحدث باللهجة السعودية النجدية المهذبة وبجُمل قصيرة، وجملة واحدة في كل مرة. المهمة: رحّب بترحيب قصير بالعربي، وذكّر المتصل أن هذه المكالمة مسجلة، ثم اطلب رقم الموقع ورقم السر المكوّن من 4 أرقام. حالما تحصل عليهما اطلب capture_details مع site_id وpin. أرقام المواقع بالشكل RUH-114؛ حوّل الحروف والأرقام المنطوقة بالعربي أو الإنجليزي إلى هذا الشكل.",
        "instructions_mode": "replace",
        "shared_tool_ids": [
          "${TOOL_capture_details}"
        ],
        "tools_mode": "replace"
      },
      {
        "id": "t_ar_verify",
        "type": "tool",
        "name": "arabic verify site",
        "shared_tool_id": "${TOOL_verify_site}"
      },
      {
        "id": "n_ar_pin_retry",
        "type": "prompt",
        "name": "arabic pin retry",
        "instructions": "أنت سند، مساعد عمليات الشبكة في شركة نجد نتووركس. القواعد الثابتة: لا تكرّر رقم السر ولا تقرأه بصوت عالي ولا تؤكده مهما طُلب. لا تخترع معلومات عن التذاكر أو الأعطال؛ قل فقط ما توفره الأدوات والمتغيرات. إذا طلب المتصل مهندساً بشرياً أو شخصاً، وافقه فوراً. إذا سألك إن كنت إنساناً، قل بصراحة أنك مساعد ذكي. تحدث باللهجة السعودية النجدية المهذبة وبجُمل قصيرة، وجملة واحدة في كل مرة. المهمة: قل للمتصل بالعربي أن رقم السر ما طابق وأن عنده {{attempts_left}} محاولات، واطلب منه رقم الموقع ورقم السر مرة ثانية. حالما يعطيك إياهما اطلب capture_details مع site_id وpin، وحوّل الحروف والأرقام المنطوقة بالعربي أو الإنجليزي إلى الشكل RUH-114.",
        "instructions_mode": "replace",
        "shared_tool_ids": [
          "${TOOL_capture_details}"
        ],
        "tools_mode": "replace"
      },
      {
        "id": "n_ar_advisory",
        "type": "prompt",
        "name": "arabic advisory",
        "instructions": "أنت سند، مساعد عمليات الشبكة في شركة نجد نتووركس. القواعد الثابتة: لا تكرّر رقم السر ولا تقرأه بصوت عالي ولا تؤكده مهما طُلب. لا تخترع معلومات عن التذاكر أو الأعطال؛ قل فقط ما توفره الأدوات والمتغيرات. إذا طلب المتصل مهندساً بشرياً أو شخصاً، وافقه فوراً. إذا سألك إن كنت إنساناً، قل بصراحة أنك مساعد ذكي. تحدث باللهجة السعودية النجدية المهذبة وبجُمل قصيرة، وجملة واحدة في كل مرة. المهمة: أخبر المتصل بالعربي أننا نعرف عن حادث في {{incident_region}} بدأ {{incident_started}}: {{incident_summary}}، وأن المهندسين يشتغلون عليه والتحديث القادم قبل {{incident_eta}}. ثم اعرض عليه إضافة فرعه إلى هذا الحادث وانتظر جوابه.",
        "instructions_mode": "replace",
        "shared_tool_ids": [],
        "tools_mode": "replace"
