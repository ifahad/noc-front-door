# Telnyx API key for the Voice AI assistant and Edge Compute APIs.
TELNYX_API_KEY=
# Bearer token the custom MCP server accepts from the assistant's tool nodes.
MCP_TOKEN=
# Bearer token for the /ops/* signed routes (Fahad's operator tooling).
OPS_TOKEN=
# Pepper used when deriving PIN fingerprints; never logged or committed.
PIN_PEPPER=
# Same value as OPS_TOKEN, used by OpenCode for the noc-mcp entry.
NOC_OPS_TOKEN=
# Telnyx public key used to verify webhook signatures on signed routes.
TELNYX_PUBLIC_KEY=
# Base URL of the deployed noc-edge function, used by the operator scripts
# (prober, ops.mjs, race-test, apply). Copy the /demo URL's origin.
EDGE_URL=
# E.164 phone number of the on-call engineer (the transfer destination in
# assistant/tools.json). Required by apply.mjs; leave empty for --dry-run.
ONCALL_NUMBER=
